# ---- Rust / Cargo ----
/target
**/target
*.rs.bk
*.pdb

# Keep the root workspace lockfile tracked for reproducible demo/integration
# builds. The vendored rustls fork stays its own workspace; its generated lock
# file is not part of this release.
/rustls-integration/rustls/Cargo.lock

# ---- Editors / OS ----
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.bak
.idea/
.vscode/
.zed/
*.iml

# ---- Scratch / logs ----
/scratch/
*.tmp
*.log

# ---- Python (vectors/reproduce.py) ----
__pycache__/
*.pyc

# ---- TLS demo capture artifacts (Stage 5) ----
*.keylog
sslkeylog*.txt
*.pcap
*.pcapng

# ---- Reference documents (doc/) ----
# The reference RFCs / NIST PDFs / IACR papers under doc/ are fetched, large
# (~20 MB total), and freely re-downloadable. They are TRACKED by default so the
# working set is self-contained. To keep them out of git instead, uncomment:
#   doc/*.pdf
#   doc/RFC*.txt
# The I-D itself (doc/draft-*.txt) is never matched by those globs, so it always
# stays tracked.
